{
  "name": "blended-storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "schemas": "bash scripts/fetch-schemas.sh",
    "validate:graphql": "node scripts/validate-graphql.mjs",
    "setup:shopify": "node --env-file=.env.local scripts/setup-shopify.ts",
    "check": "npm run typecheck && npm run lint && npm run validate:graphql"
  },
  "dependencies": {
    "@shopify/hydrogen-react": "^2026.4.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "botid": "^1.5.11",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "graphql": "^17.0.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
