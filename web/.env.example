# Copy to .env.local. With the Shopify values empty the app runs in demo mode
# on the design's sample catalog (nothing is sent to Shopify).

# --- Store ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07

# Storefront API — Headless sales channel → Storefront API → private access token
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Admin API — either a static token…
SHOPIFY_ADMIN_ACCESS_TOKEN=
# …or a Dev Dashboard app's credentials (client-credentials grant). The client
# secret is also used to verify webhook signatures.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only if your webhooks are signed with a different secret:
SHOPIFY_WEBHOOK_SECRET=

# Customer Account API (wholesale sign-in) — Headless channel → Customer Account API
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Set only for a confidential client:
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=

# Customers with this tag can order on the Wholesale tab
SHOPIFY_WHOLESALE_TAG=wholesale
# Smart collection holding "Our coffees" (created by npm run setup:shopify)
SHOPIFY_STOCK_COLLECTION=our-coffees
SHOPIFY_CURRENCY=USD
# Location green coffee is counted at (grams). Blank = the primary location.
SHOPIFY_LOCATION_ID=

# --- Storefront analytics, consent, email (all optional; each turns on when set) ---
# Headless channel → your storefront → Storefront ID (numeric). Tags Shopify analytics.
SHOPIFY_STOREFRONT_ID=
# Headless channel → Storefront API → public access token. Lets the cookie banner
# share the visitor's choice with Shopify checkout (Customer Privacy API).
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Klaviyo → Settings → API keys → public key (site ID), and the list signups join.
KLAVIYO_PUBLIC_KEY=
KLAVIYO_LIST_ID=

# Landing page "Merch" and "Brew gear" tiles (default to blendedcoffeelab.com collections)
LANDING_MERCH_URL=
LANDING_GEAR_URL=

# --- App ---
# Public URL of this deployment (OAuth redirect + webhook URL)
APP_URL=http://localhost:3000
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=
# Password for /admin (required in production)
ADMIN_PASSWORD=
